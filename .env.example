APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://forkemail:forkemail@localhost:5433/forkemail?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080
UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-characters
SEED_TOKEN=replace-with-at-least-32-random-characters-too
TRUSTED_PROXY=
SENDER_DRIVER=log
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=forkemail
SNS_TOPIC_NAME=forkemail-ses-events
SNS_TOPIC_ARN=
SES_TEST_EMAIL=
MAX_BOUNCE_RATE=0.05
MAX_COMPLAINT_RATE=0.001
REPUTATION_MIN_SAMPLE=100
SEND_RATE_PER_SEC=20
TRIAL_SEND_RATE_PER_SEC=1
API_PAID_RATE_PER_SEC=20
API_PAID_BURST=40
API_TRIAL_RATE_PER_SEC=2
API_TRIAL_BURST=5
PUBLIC_RATE_PER_SEC=10
PUBLIC_BURST=30
AUTH_FAILURES_PER_MIN=10
AUTH_FAILURE_BURST=10
WEBHOOK_ENCRYPTION_KEY=
TRANSACTIONAL_STUB_ENABLED=false
