[Unit]
Description=Forke Mail
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=forkemail
Group=forkemail
WorkingDirectory=/opt/forke/forke-mail
EnvironmentFile=/opt/forke/forke-mail/.env.production
ExecStart=/opt/forke/forke-mail/forke-mail
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/forke/forke-mail

[Install]
WantedBy=multi-user.target
